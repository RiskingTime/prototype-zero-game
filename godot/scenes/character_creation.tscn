[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/character_creation.gd" id="1"]

[node name="CharacterCreation" type="CenterContainer"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Panel" type="VBoxContainer" parent="."]
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Panel"]
text = "Character Creation"
theme_override_font_sizes/font_size = 36

[node name="Back" type="Button" parent="Panel"]
text = "Back"

[connection signal="pressed" from="Panel/Back" to="." method="_return_to_menu"]
